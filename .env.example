# Required for AI Chat. Get your key from https://platform.openai.com/api-keys
# Paste the key on a single line with no quotes and no extra spaces so it is sent as-is.
OPENAI_API_KEY=your_openai_key

# Optional: dedicated API key for Document Field Comparison (extracts shipper, consignee, etc.).
# If not set, the tool uses OPENAI_API_KEY for extraction.
# DOCUMENT_EXTRACTION_API_KEY=your_key

# Chat uses a website knowledge base (data/knowledge.json). To enable semantic search,
# generate embeddings once: OPENAI_API_KEY=your_key npm run embed
# This writes data/knowledge-embeddings.json. Commit that file so production does not need the key at build time.

# Landed Cost Calculator: live FX for international freight (USD) → local currency.
# Get a key from https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key

# SimplyDuty API for duty calculator.
SIMPLYDUTY_BASE_URL=your_simplyduty_base_url
SIMPLYDUTY_API_KEY=your_simplyduty_api_key

# Auth/backend API base URL (signup, login, RFQ APIs).
BACKEND_API_URL=your_backend_api_url

# Public backend URL for client-side API calls and uploaded file URLs.
NEXT_PUBLIC_BACKEND_API_URL=your_public_backend_api_url

# Frontend origin for post-login redirects (Google OAuth).
NEXT_PUBLIC_APP_URL=your_frontend_app_url

# Waitlist (/waitlist) saves signups to data/waitlist.json on the server's disk.
# View and export them at /admin/waitlist, which is gated by this password.
# Use a long random value, e.g. `openssl rand -base64 24`.
# NOTE: file storage needs a persistent disk. On serverless hosts (Vercel,
# Netlify) the filesystem is wiped between requests and signups will be lost.
WAITLIST_ADMIN_PASSWORD=your_long_random_admin_password
