# Waitlist admin password — required to access /admin/waitlist
# Use a long random value, e.g. `openssl rand -base64 24`
WAITLIST_ADMIN_PASSWORD=

# Neon Postgres (pooled connection string — server-only, no quotes)
DATABASE_URL=

# Resend — welcome email after waitlist signup
RESEND_API_KEY=

# Meta Lead Ads sync
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# Meta Lead Ads webhook (used by /api/webhooks/meta-leads)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Shared secret for scheduled Meta lead backfill (x-cron-secret header)
# Generate with: openssl rand -hex 32
# Same value must be set in Vercel and GitHub Actions secrets — never commit it
CRON_SECRET=
