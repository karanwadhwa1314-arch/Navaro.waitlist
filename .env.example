# Waitlist admin password — required to access /admin/waitlist
# Use a long random value, e.g. `openssl rand -base64 24`
WAITLIST_ADMIN_PASSWORD=your_long_random_admin_password

# Supabase (service role is server-only — never expose to the client)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend — welcome email after waitlist signup
RESEND_API_KEY=your_resend_api_key
