# Waitlist admin password — required to access /admin/waitlist
# Use a long random value, e.g. `openssl rand -base64 24`
WAITLIST_ADMIN_PASSWORD=

# Supabase (service role is server-only — never expose to the client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — welcome email after waitlist signup
RESEND_API_KEY=

# Cloudflare Turnstile (CAPTCHA on waitlist form)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (shared rate limiting across serverless instances)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
